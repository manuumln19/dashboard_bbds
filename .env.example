# Copia este archivo a .env.local para desarrollo o crea estas variables
# en Cloudflare Pages/Workers para el build de producción.
#
# En producción deja VITE_DEMO_MODE=false. Para probar sin backend:
#   npm run dev:demo
VITE_DEMO_MODE=false

# Normalmente vacío: la web y la API se sirven desde el mismo Worker.
# En desarrollo Vite redirige /api al Worker local automáticamente.
VITE_API_BASE=

# Opcional. Si configuras DASHBOARD_TOKEN en el Worker, pon aquí el mismo valor.
# Ojo: al ser una web estática, este token viaja en el bundle. Para una casa
# está bien; si publicas la URL, protege el Worker con Cloudflare Access.
VITE_DASHBOARD_TOKEN=

# Lugar para Open-Meteo.
VITE_LOCATION_NAME=Jaén
VITE_LATITUDE=37.7796
VITE_LONGITUDE=-3.7849
VITE_TIMEZONE=Europe/Madrid

# Modo noche automático (hora local del dispositivo).
VITE_NIGHT_START=22:30
VITE_NIGHT_END=07:30

# Días de agenda que se piden al Worker.
VITE_CALENDAR_DAYS=21

# Muestra Casa, el histórico de sensores y las llamadas a /api/sensors.
# Déjalo en false hasta instalar los sensores; Inicio nunca muestra clima.
VITE_CLIMATE_ENABLED=false

# Minutos sin actividad antes de abrir la galería de fotos.
# Usa 0 para desactivar la apertura automática; el botón del rail sigue activo.
VITE_SCREENSAVER_IDLE_MINUTES=3
