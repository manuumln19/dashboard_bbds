{
  "name": "bbds-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BBDS: dashboard doméstico para pantalla táctil con agenda, listas, limpieza, tiempo, energía y galería.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "vite build",
    "preview": "vite preview",
    "api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply bbds-db --local",
    "db:migrate": "wrangler d1 migrations apply bbds-db --remote",
    "sensors:simulate": "node scripts/simulate-sensors.mjs",
    "telegram:setup": "node scripts/telegram-setup.mjs",
    "check:webview": "node scripts/check-webview.mjs",
    "check:energy": "node scripts/check-energy.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ical.js": "^2.2.1",
    "lucide-react": "^0.468.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.7",
    "wrangler": "^4.20.0"
  }
}
